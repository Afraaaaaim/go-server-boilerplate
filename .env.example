# Server
PORT=8080
ENV=development

# Logging
# LOG_LEVEL: debug | info | warn | error
LOG_LEVEL=info
# LOG_FORMAT: text | json
LOG_FORMAT=text
# LOG_FILE: leave empty for stdout, or set a file path e.g. ./logs/app.log
LOG_FILE=

# Auth
# Comma-separated list of valid API keys
# Leave empty to disable auth middleware
API_KEYS=secret-key-1,secret-key-2

# Rate Limiting
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=20

# OpenTelemetry
# Leave empty to disable OTLP export
OTLP_ENDPOINT=
SERVICE_NAME=go-server-boilerplate